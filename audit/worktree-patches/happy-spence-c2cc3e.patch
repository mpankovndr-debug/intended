diff --git a/test/moments_service_test.dart b/test/moments_service_test.dart
index d441a3d..f3fa411 100644
--- a/test/moments_service_test.dart
+++ b/test/moments_service_test.dart
@@ -65,4 +65,51 @@ void main() {
     final all = await MomentsService.getAll();
     expect(all.single.source, 'widget');
   });
+
+  // The profile count row froze at its launch-time value because nothing
+  // told it the store had changed — the tab sits in an IndexedStack and
+  // never rebuilds on tab switch. Every write must bump [revision]; a write
+  // that changed nothing must not, so listeners don't re-read for no reason.
+  group('revision', () {
+    test('record bumps it', () async {
+      final before = MomentsService.revision.value;
+      await MomentsService.record(_at(DateTime(2026, 8, 13, 9)));
+      expect(MomentsService.revision.value, before + 1);
+    });
+
+    test('annotate bumps it when the annotation lands', () async {
+      await MomentsService.record(_at(DateTime(2026, 8, 13, 9)));
+      final id = (await MomentsService.getAll()).single.id;
+      final before = MomentsService.revision.value;
+      await MomentsService.annotate(id, note: 'gentle');
+      expect(MomentsService.revision.value, before + 1);
+    });
+
+    test('a no-op annotate does not bump it', () async {
+      await MomentsService.record(_at(DateTime(2026, 8, 13, 9)));
+      final before = MomentsService.revision.value;
+      await MomentsService.annotate('no-such-id', note: 'lost');
+      await MomentsService.annotate('any-id'); // neither mood nor note
+      expect(MomentsService.revision.value, before);
+    });
+
+    test('backfill bumps it only when something was repaired', () async {
+      await MomentsService.record(Moment.create(
+        habitName: 'Evening pages',
+        at: DateTime(2026, 8, 13, 21),
+        id: 'uncategorised',
+      ));
+      final before = MomentsService.revision.value;
+
+      final none =
+          await MomentsService.backfillCustomCategories({'Unknown': 'Mind'});
+      expect(none, 0);
+      expect(MomentsService.revision.value, before);
+
+      final repaired = await MomentsService
+          .backfillCustomCategories({'Evening pages': 'Mind'});
+      expect(repaired, 1);
+      expect(MomentsService.revision.value, before + 1);
+    });
+  });
 }
