+// MARK: - Snapshot policy
+
+/// What a snapshot shows. One rule for all three providers, so the gallery
+/// can't drift between them.
+///
+/// The widget gallery (`context.isPreview`) is a catalogue, and the HIG
+/// asks for a realistic preview there: the user's own day when the app has
+/// written one, and the sample day before it has — never "0/0 today". The
+/// paid layout is always on in the gallery, so it shows the widget rather
+/// than its paywall; what the placed widget then shows is the app's call.
+///
+/// Off the gallery — the transient snapshot WidgetKit takes as a widget is
+/// placed — only what the app wrote is shown. The sample never reaches a
+/// Home Screen.
+func snapshotContent(in context: TimelineProviderContext) -> WidgetContent {
+    let written = loadWidgetContent()
+    guard context.isPreview else { return written }
+    return written.habits.isEmpty ? .sample(locale: written.locale) : written.unlocked()
