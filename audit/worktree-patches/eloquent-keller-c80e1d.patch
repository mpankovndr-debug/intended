@@ -202,6 +218,31 @@ extension Color {
 struct WidgetStrings {
     let locale: String
 
+    /// The language the views speak before the app has ever written
+    /// `widget_locale`: the one iOS resolved for this bundle. `Bundle.main`
+    /// is the extension itself, and it ships exactly en and ru, so this is
+    /// always one of the two. It is also the resolution WidgetKit uses to
+    /// pick the gallery name and description out of Localizable.strings, so
+    /// a preview and the caption beneath it can't disagree — which they did
+    /// when this was a hardcoded "en".
+    ///
+    /// `Locale.preferredLanguages.first` would be wrong here: a phone set to
+    /// German, then Russian, gets Russian gallery copy because the bundle
+    /// has no German, and the views must make the same choice.
+    static var deviceLocale: String {
+        let resolved = Bundle.main.preferredLocalizations.first ?? "en"
+        return resolved.hasPrefix("ru") ? "ru" : "en"
+    }
+
+    /// The intention line before the app has written one. The app sends
+    /// the user's chosen intention (refreshHomeWidget in main.dart), so the
+    /// fallback is the one intention that's true of someone who hasn't
+    /// chosen yet — `intentionYourOwnWay` in app_en.arb / app_ru.arb —
+    /// rather than a stock affirmation the rest of the app no longer uses.
+    var defaultGreeting: String {
+        locale == "ru" ? "Свой путь" : "Your own way"
+    }
+
     var today: String {
         locale == "ru" ? "сегодня" : "today"
     }
